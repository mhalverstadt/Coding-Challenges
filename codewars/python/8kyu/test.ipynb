   "source": [
    "# Description:\n",
    "Define a method named countCharOccurrences or count_char_occurrences that accepts a string and a char as inputs and returns the number of times the char occurs in the string as an int.\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "55f75427",
   "metadata": {},
   "outputs": [],
   "source": [
    "def countCharOccurrences(s: str, char: str):\n",
    "    return s.count(char)\n",
    "\n",
    "print()"
   ]
  }
